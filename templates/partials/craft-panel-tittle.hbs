{{!-- 标题栏组件：显示面板标题和编辑模式下的尺寸配置图标 --}}
<div class="craft-panel-tittle">
    <h2>{{#if tittle}}{{localize tittle}}{{else}}{{#if panelSizes.[type].name}}{{panelSizes.[type].name}}{{else}}{{localize (craftpanel-concat "craftpanel." type)}}{{/if}}{{/if}}</h2>
    {{#if isEdit}}<i class="fas fa-cog" data-name="{{type}}" data-tooltip="{{localize "craftpanel.change-panel-size"}}"></i>{{/if}}
</div>