<div class="craft-panel">
    {{> craft-panel-tittle type="elementitems" tittle="craftpanel.elements"}}
    <div class="craft-elementitems-panel" style="width:{{craftpanel-exist panelSizes.elementitems.width width}}px;height:{{craftpanel-exist panelSizes.elementitems.height height}}px;">
        {{#each elementItems as |element|}}
        <div draggable="true" data-tooltip="{{element.name}}" class="element-slot elements"
            data-index="{{element.slotIndex}}" data-uuid="{{element.uuid}}" data-id="{{element.id}}" data-inslot="false"
            style="{{#if element.img}}background-image: url('{{element.img}}');{{/if}} ">
            <i class="element-color-circle fa-solid fa-{{element.shape}}" draggable="false" style="color: {{element.color}};"></i>
        </div>
        {{/each}}
    </div>
</div>