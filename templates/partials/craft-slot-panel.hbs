{{!-- 槽位面板：显示合成槽位网格，支持拖拽、选中筛选、锁定状态 --}}
<div class="craft-panel">
    {{> craft-panel-tittle type="slots" panelSizes=panelSizes isEdit=isEdit}}
    <div class="craft-slot-panel main-child-panel" style="width:{{craftpanel-exist panelSizes.slots.width width}}px;height:{{craftpanel-exist panelSizes.slots.height height}}px;position: relative;">
        {{!-- "保留材料"切换开关 --}}
        <label class="craft-slot-keep-toggle" data-tooltip="{{localize "craftpanel.craft-panel.keep-materials-tooltip"}}">
            <input type="checkbox" name="keep-materials" {{#if keepMaterials}}checked{{/if}}>
            {{localize "craftpanel.craft-panel.keep-materials"}}
        </label>
        {{!-- 遍历所有槽位 --}}
        {{#each slots as |slot|}}
        <div {{#if slot.draggable}}draggable="true"{{/if}} data-tooltip-class="craft-tooltip" data-tooltip="{{slot.tooltip}}"
            class="craft-slot {{slot.empty}} {{slot.actualShowType}} {{#if slot.overrideStyle}}{{slot.overrideStyleClass}}{{else}}round{{/if}} {{#if slot.isSelected}}selected{{/if}}" 
            data-index="{{slot.slotIndex}}" data-uuid="{{slot.uuid}}"
            style="width: {{slot.size}}px;height: {{slot.size}}px; 
            {{#if slot.position.unlock}}position: absolute; top: {{slot.position.y}}px; left: {{slot.position.x}}px;{{/if}} 
            {{#if slot.itemColor}}--item-color: {{slot.itemColor}};{{/if}} background-image: url('{{#if slot.item.img}}{{slot.item.img}}{{else}}{{slot.image}}{{/if}}'); 
            {{#if slot.empty}}filter: sepia(1) brightness(0.6) hue-rotate({{slot.hue}}deg);{{/if}}">
            {{!-- 槽位内元素点显示 --}}
            <div class="craft-slot-elements" {{#unless slot.showElements}}hidden="true" {{/unless}}{{#if slot.empty}}hidden="true" {{/if}} draggable="false">
                {{#each slot.elements as |element|}}
                <div class="slot-element-circle-container">
                    {{#each (craftpanel-range 0 element.num)}}
                    <i class="slot-element-circle fa-solid fa-{{element.shape}}" draggable="false" style="color: {{element.color}};"></i>
                    {{/each}}
                </div>
                {{/each}}
            </div>
            {{!-- 数量显示 --}}
            <div class="element-num" {{#unless slot.showQuantity}}hidden="true"{{/unless}} draggable="false">
                {{slot.quantity}}
            </div>
            {{!-- 锁定图标 --}}
            <i draggable="false" class="fa-solid fa-lock slot-locked" style="line-height: {{slot.size}}px; font-size: {{slot.lockSize}}px;{{#unless slot.isLocked}}display:none;{{/unless}}"></i>
        </div>
        {{/each}}
    </div>
</div>
