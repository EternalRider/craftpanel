<div class="standard-form">
    <div class="craft-content">
        {{> craft-modifiers-panel width=300 height=420 draggable="true" cost=cost modifiers=modifiers categories=categories panelSizes=panelSizes isEdit=isEdit}}
        <div class="craft-main-panel" style="width: 300px;">
            {{> craft-ingredients-panel width=300 height=200 ingredients=ingredients panelSizes=panelSizes}}
            <div class="craft-panel">
                {{> craft-panel-tittle tittle="craftpanel.modifier"}}
                <div class="craft-changes-panel main-child-panel" style="width:{{craftpanel-exist panelSizes.changes.width 300}}px;height:{{craftpanel-exist panelSizes.changes.height 170}}px;">
                    {{!-- <header class="effect-change effects-header flexrow" style="">
                        <div class="key">{{localize "EFFECT.ChangeKey"}}</div>
                        <div class="mode">{{localize "EFFECT.ChangeMode"}}</div>
                        <div class="value">{{localize "EFFECT.ChangeValue"}}</div>
                    </header> --}}
                    <ol class="changes-list" style="margin: 1px; padding: 0px;">
                        {{#each changes as |change|}}
                        <li class="effect-change flexrow" data-index="{{@index}}">
                            <div class="key" data-tooltip="{{localize "EFFECT.ChangeKey"}}">
                                <input type="text" name="changes.{{@index}}.key" value="{{change.key}}" style="pointer-events: none;">
                            </div>
                            <div class="mode" data-tooltip="{{localize "EFFECT.ChangeMode"}}">
                                <select name="changes.{{@index}}.mode" data-dtype="Number" style="pointer-events: none;">
                                    <option value="0" {{#if (craftpanel-equal 0 change.mode)}}selected{{/if}}>{{localize "EFFECT.MODE_CUSTOM"}}</option>
                                    <option value="1" {{#if (craftpanel-equal 1 change.mode)}}selected{{/if}}>{{localize "EFFECT.MODE_MULTIPLY"}}</option>
                                    <option value="2" {{#if (craftpanel-equal 2 change.mode)}}selected{{/if}}>{{localize "EFFECT.MODE_ADD"}}</option>
                                    <option value="3" {{#if (craftpanel-equal 3 change.mode)}}selected{{/if}}>{{localize "EFFECT.MODE_DOWNGRADE"}}</option>
                                    <option value="4" {{#if (craftpanel-equal 4 change.mode)}}selected{{/if}}>{{localize "EFFECT.MODE_UPGRADE"}}</option>
                                    <option value="5" {{#if (craftpanel-equal 5 change.mode)}}selected{{/if}}>{{localize "EFFECT.MODE_OVERRIDE"}}</option>
                                </select>
                            </div>
                            <div class="value" data-tooltip="{{localize "EFFECT.ChangeValue"}}">
                                <input type="text" name="changes.{{@index}}.value" value="{{change.value}}" style="pointer-events: none;">
                            </div>
                        </li>
                        {{/each}}
                    </ol>
                    <button type="button" name="new-modifier" data-action="new-modifier"><i class="fas fa-plus"></i></button>
                </div>
            </div>
        </div>
        {{> craft-elementitems-panel width=300 height=420 elementItems=elementItems panelSizes=panelSizes}}
    </div>

    <footer class="form-footer">
        <button type="button" name="edit" data-action="edit"><i class="fas fa-save"></i> {{localize "craftpanel.save"}}</button>
        <button type="button" name="permissions" data-action="permissions"><i class="fas fa-user-lock"></i> {{localize "craftpanel.permissions"}}</button>
        <button type="button" name="configure" data-action="configure"><i class="fas fa-cog"></i> {{localize "craftpanel.configure"}}</button>
        <button type="button" name="close" data-action="close"><i class="fas fa-times"></i>{{localize "Close"}}</button>
    </footer>
</div>