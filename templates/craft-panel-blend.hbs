<div class="standard-form" style="background-image: {{background}}">
    <div class="craft-content {{#if isEdit}}edit{{/if}}" data-type="craft-panel-blend">
        {{> craft-recipes-panel width=300 height=540 recipes=recipes categories=categories panelSizes=panelSizes isEdit=isEdit}}
        <div class="craft-main-panel">
            {{> craft-slot-panel width=600 height=300 slots=slots panelSizes=panelSizes isEdit=isEdit keepMaterials=keepMaterials}}
            {{> craft-elements-panel width=600 height=75 elements=elements panelSizes=panelSizes isEdit=isEdit}}
            {{> craft-results-panel width=600 height=100 results=results panelSizes=panelSizes isEdit=isEdit}}
        </div>
        {{> craft-materials-panel width=300 height=540 materials=materials categories=categories panelSizes=panelSizes isEdit=isEdit}}
    </div>

    <footer class="form-footer">
        {{#if isEdit}}
        <button type="button" name="new-slot" data-action="new-slot"><i class="fas fa-plus"></i> {{localize "craftpanel.craft-panel.new-slot"}}</button>
        <button type="button" name="configure-panel" data-action="configure-panel"><i class="fas fa-cog"></i> {{localize "craftpanel.configure"}}</button>
        {{else}}
        <button type="button" name="craft" data-action="craft"><i class="fa-regular fa-flask-round-potion"></i>{{localize "craftpanel.craft"}}</button>
        {{/if}}
        <button type="button" name="close" data-action="close"><i class="fas fa-times"></i>{{localize "Close"}}</button>
    </footer>
</div>