<div class="standard-form">
    <div class="craft-content">
        {{> craft-recipes-panel width=300 height=420 draggable="true" recipes=recipes panelSizes=panelSizes}}
        <div class="craft-main-panel">
            {{> craft-ingredients-panel width=600 height=150 ingredients=ingredients panelSizes=panelSizes}}
            {{> craft-elements-panel width=600 height=75 elements=elements panelSizes=panelSizes}}
            {{> craft-results-panel width=600 height=100 results=results panelSizes=panelSizes}}
        </div>
    </div>

    <footer class="form-footer">
        {{#if isEdit}}
        <button type="button" name="delete" data-action="delete"><i class="fas fa-trash"></i>{{localize "Delete"}}</button>
        {{else}}
        <button type="button" name="choose" data-action="choose"><i class="fas fa-plus"></i>{{localize "craftpanel.craft-panel-cook-recipe.choose"}}</button>
        {{/if}}
        <button type="button" name="close" data-action="close"><i class="fas fa-times"></i>{{localize "Close"}}</button>
    </footer>
</div>