<div class="standard-form">
    <div class="craft-content">
        <div class="craft-panel">
            {{> craft-panel-tittle tittle="Players"}}
            <div class="craft-players-panel" style="width:{{craftpanel-exist panelSizes.players.width 300}}px;height:{{craftpanel-exist panelSizes.players.height 420}}px;">
                {{#each players as |player|}}
                <div draggable="false" data-tooltip="{{player.name}}" class="craft-player {{player.choosed}}"
                    data-uuid="{{player.uuid}}" data-id="{{player.id}}"
                    style="--player-color: {{player.color.css}}; ">
                    <h3 class="player-name">{{player.name}}</h3>
                </div>
                {{/each}}
            </div>
        </div>
        {{> craft-recipes-panel width=300 height=420 draggable="true" recipes=recipes panelSizes=panelSizes}}
    </div>

    <footer class="form-footer">
        <button type="button" name="edit" data-action="edit"><i class="fas fa-edit"></i>{{localize "craftpanel.edit"}}</button>
        <button type="button" name="close" data-action="close"><i class="fas fa-times"></i>{{localize "Close"}}</button>
    </footer>
</div>