<div class="standard-form">
    <div class="craft-content">
        {{> craft-elementitems-panel width=420 height=420 elementItems=elementItems panelSizes=panelSizes}}
        <div class="craft-main-panel" style="width: 300px;">
            <div class="craft-panel">
                {{> craft-panel-tittle tittle="craftpanel.materials"}}
                <div class="craft-slot-panel main-child-panel" style="width:{{craftpanel-exist panelSizes.slots.width 300}}px;height:{{craftpanel-exist panelSizes.slots.height 200}}px;">
                    {{#each slots as |slot|}}
                    <div draggable="true" data-tooltip-class="craft-tooltip" data-tooltip="{{slot.tooltip}}"
                        class="element-slot materials" data-index="{{slot.index}}" data-uuid="{{slot.uuid}}" data-inslot="true"
                        style="{{#if slot.itemColor}}box-shadow: inset 0 0 10px {{slot.itemColor}}; border-color: {{slot.itemColor}};{{/if}} {{#if slot.item.img}}background-image: url('{{slot.item.img}}');{{/if}} ">
                        <div class="craft-slot-elements" {{#unless slot.showElements}}hidden="true" {{/unless}} draggable="false">
                            {{#each slot.elements as |element|}}
                            <div class="slot-element-circle-container">
                                {{#each (craftpanel-range 0 element.num)}}
                                <i class="slot-element-circle fa-solid fa-{{element.shape}}" draggable="false" style="color: {{element.color}};"></i>
                                {{/each}}
                            </div>
                            {{/each}}
                        </div>
                    </div>
                    {{/each}}
                </div>
            </div>
            {{> craft-elements-panel width=300 height=175 elements=elements panelSizes=panelSizes}}
        </div>
        {{> craft-materials-panel width=420 height=420 materials=materials panelSizes=panelSizes}}
    </div>

    <footer class="form-footer">
        <button type="button" name="edit" data-action="edit"><i class="fas fa-save"></i> {{localize "craftpanel.save"}}</button>
        <button type="button" name="configure" data-action="configure"><i class="fas fa-cog"></i> {{localize "craftpanel.configure"}}</button>
        <button type="button" name="close" data-action="close"><i class="fas fa-times"></i>{{localize "Close"}}</button>
    </footer>
</div>