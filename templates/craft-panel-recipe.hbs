{{!-- 配方编辑面板：编辑配方的材料需求、结果和元素物品 --}}
<div class="standard-form">
    <div class="craft-content">
        {{> craft-recipes-panel width=300 height=420 draggable="true" recipes=recipes panelSizes=panelSizes}}
        <div class="craft-main-panel">
            {{> craft-ingredients-panel width=300 height=200 ingredients=ingredients panelSizes=panelSizes}}
            {{> craft-results-panel width=300 height=175 results=results panelSizes=panelSizes}}
        </div>
        {{> craft-elementitems-panel width=300 height=420 elementItems=elementItems panelSizes=panelSizes}}
    </div>

    <footer class="form-footer">
        <button type="button" name="edit" data-action="edit"><i class="fas fa-save"></i> {{localize "craftpanel.save"}}</button>
        <button type="button" name="permissions" data-action="permissions"><i class="fas fa-user-lock"></i> {{localize "craftpanel.permissions"}}</button>
        <button type="button" name="configure" data-action="configure"><i class="fas fa-cog"></i> {{localize "craftpanel.configure"}}</button>
        <button type="button" name="close" data-action="close"><i class="fas fa-times"></i>{{localize "Close"}}</button>
    </footer>
</div>